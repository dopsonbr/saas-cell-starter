{
  "name": "saas-cell-starter",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/**' dev",
    "build": "pnpm -r --filter './packages/**' build && pnpm -r --filter './apps/**' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:code && pnpm format:check",
    "lint:code": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "e2e": "pnpm --filter @starter/e2e test",
    "e2e:web": "pnpm --filter @starter/e2e test:web",
    "e2e:api": "pnpm --filter @starter/e2e test:api",
    "e2e:install": "pnpm --filter @starter/e2e install:browsers",
    "init:project": "node scripts/init-template.mjs"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "5.9.3"
  }
}
