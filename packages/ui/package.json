  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
