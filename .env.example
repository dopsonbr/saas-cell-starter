# This file documents the complete configuration surface.
# Copy only the relevant values into each Vercel project / local app.
# Secrets belong in ignored local env files or injected environment variables, never source control.

# Customer identity
CUSTOMER_SLUG=example-customer
EXPECTED_CLERK_ORG_ID=org_xxx

# Web (browser-visible by definition)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_API_URL=http://localhost:3001

# API
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Public verification key; server configuration, but not confidential.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://...
AI_PROVIDER=mock
AI_MODEL=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
VERCEL_GIT_COMMIT_SHA=

# Shared observability / analytics metadata
OTEL_SERVICE_NAME=saas-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
ANALYTICS_TENANT_KEY=example-customer

# Marketing
VITE_APP_URL=http://localhost:5173
